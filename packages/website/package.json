{
  "name": "@rx4u/website",
  "version": "1.0.0",
  "description": "Official website for rx4u reactive library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run --environment node",
    "test:watch": "vitest --environment node",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "wrangler-dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "deploy": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@solidjs/router": "^0.16.1",
    "rx4u": "workspace:*",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.22",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "rx4u",
    "reactive",
    "website",
    "documentation",
    "solid-js"
  ],
  "author": "rx4X",
  "license": "MIT"
}
